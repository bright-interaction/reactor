# Build artefacts. /reactor is anchored so the binary is ignored at
# the project root but cmd/reactor/ (the source dir) stays tracked.
/bin/
/dist/
/reactor
/reactor.exe

# Local data
*.db
*.db-journal
*.db-wal
*.db-shm
master.key
*.master.key

# Editor / OS
.DS_Store
.idea/
.vscode/

# Env files (per repo-wide rules)
.env
.env.*
*.env
!*.env.example

# Generated frontend bundle
/internal/web/dist/

# Test artefacts
coverage.out
coverage.html

# Agent memory and per-project Claude config. Subagents with `memory: project`
# write here, and the notes are defect analyses of code that is often still
# unfixed. This subtree publishes to a PUBLIC mirror rebuilt from subtree
# HISTORY, so a single `git add -A` would carry them into every future publish
# and only a filter-repo strip could remove them again. Ignored at the source.
.claude/
