// {{.Slug}} is a scheduled report generator. Fires on a cron trigger,
// queries a source HTTP endpoint, formats the response, and posts a
// summary to Slack (or any chat webhook).
// Generated by `reactor new scheduled-report {{.Slug}}` on {{.Date}}.
//
// Build:    reactor workflow build --src . --slug {{.Slug}}
// Register: reactor workflow register --db <url> --slug {{.Slug}} --src main.go
// Trigger:  dashboard /workflows/{{.Slug}} -> Add cron trigger ->
//           e.g. "0 9 * * 1-5" (9am weekdays).
package main

import (
	"context"
	"fmt"
	"strings"
	"time"

	"github.com/brightinteraction/reactor/sdk"
	httpc "github.com/brightinteraction/reactor/sdk/http"
	"github.com/brightinteraction/reactor/sdk/idempotency"
	"github.com/brightinteraction/reactor/sdk/runtime"
	"github.com/brightinteraction/reactor/sdk/vault"
)

//nolint:gochecknoglobals // SDK contract: package-level declarations.
var (
	Workflow = reactor.Workflow{Slug: "{{.Slug}}", Version: "0.1.0"}
	Trigger  = reactor.CronTrigger{
		Spec: "0 9 * * 1-5",
	}
)

type Input struct{}

type Output struct {
	GeneratedAt string `json:"generated_at"`
	PostedTo    string `json:"posted_to"`
	Summary     string `json:"summary"`
}

func Run(ctx context.Context, flow reactor.Flow, _ Input) (Output, error) {
	// Use SideEffect for the wall-clock window so the workflow replays
	// deterministically (the cached timestamp comes back on retry,
	// not "now" at retry time).
	stamp, err := reactor.SideEffect(flow, ctx, "report-stamp", func() string {
		return time.Now().UTC().Format("2006-01-02 15:04Z")
	})
	if err != nil {
		return Output{}, err
	}
	dayKey := strings.SplitN(stamp, " ", 2)[0]

	// Step 1: fetch the metric source.
	type sourceResp struct {
		ActiveUsers int     `json:"active_users"`
		Revenue     float64 `json:"revenue"`
	}
	var data sourceResp
	_, err = reactor.Step(flow, ctx, "fetch-metrics", reactor.StepOpts{
		IdempotencyKey: idempotency.Key("{{.Slug}}", "fetch-metrics", "day", dayKey),
		Timeout:        30 * time.Second,
		Retry:          reactor.ExpBackoff{Base: time.Second, Max: 10 * time.Second, Attempts: 3},
	}, func(ctx context.Context) (string, error) {
		c := &httpc.Client{Bearer: string(vault.MustGet("metrics-api-key").Reveal())}
		if err := c.Get(ctx, "https://metrics.example/daily", &data); err != nil {
			if !httpc.IsRetryable(err) {
				return "", reactor.Permanent(err)
			}
			return "", err
		}
		return "fetched", nil
	})
	if err != nil {
		return Output{}, err
	}

	summary := fmt.Sprintf("Daily report %s: %d active users, $%.2f revenue.",
		dayKey, data.ActiveUsers, data.Revenue)

	// Step 2: post to Slack (or any chat webhook).
	_, err = reactor.Step(flow, ctx, "post-summary", reactor.StepOpts{
		IdempotencyKey: idempotency.Key("{{.Slug}}", "post-summary", "day", dayKey),
		Timeout:        15 * time.Second,
	}, func(ctx context.Context) (string, error) {
		c := &httpc.Client{}
		webhookURL := string(vault.MustGet("chat-webhook-url").Reveal())
		var resp any
		if err := c.PostJSON(ctx, webhookURL,
			map[string]string{"text": summary}, &resp); err != nil {
			if !httpc.IsRetryable(err) {
				return "", reactor.Permanent(err)
			}
			return "", err
		}
		return "posted", nil
	})
	if err != nil {
		return Output{}, err
	}

	return Output{
		GeneratedAt: stamp,
		PostedTo:    "chat-webhook-url",
		Summary:     summary,
	}, nil
}

func main() {
	runtime.Serve[Input](Workflow, Run)
}
