// {{.Slug}} runs on a cron schedule. Demonstrates the cron trigger
// shape + a no-payload workflow body. Generated by
// `reactor new scheduled-rotation {{.Slug}}` on {{.Date}}.
package main

import (
	"context"
	"time"

	"github.com/bright-interaction/reactor/sdk"
	"github.com/bright-interaction/reactor/sdk/runtime"
)

//nolint:gochecknoglobals // SDK contract: package-level declarations.
var (
	Workflow = reactor.Workflow{Slug: "{{.Slug}}", Version: "0.1.0"}
	Trigger  = reactor.CronTrigger{Schedule: "0 * * * *"} // hourly; edit to taste
)

type Empty struct{}
type Result struct {
	OKAt int64 `json:"ok_at"`
}

func Run(ctx context.Context, flow reactor.Flow, _ Empty) error {
	flow.Logger().Info("{{.Slug}}: tick")

	at, err := reactor.SideEffect(flow, ctx, "tick-time", func() int64 {
		return time.Now().Unix()
	})
	if err != nil {
		return err
	}
	_, err = reactor.Step(flow, ctx, "do-work", reactor.StepOpts{Timeout: 30 * time.Second}, func(_ context.Context) (Result, error) {
		// Replace with the actual hourly job: trigger a rotation,
		// reconcile a registry, sync a status, etc.
		return Result{OKAt: at}, nil
	})
	return err
}

func main() {
	runtime.Serve(Workflow, Trigger, Run)
}
