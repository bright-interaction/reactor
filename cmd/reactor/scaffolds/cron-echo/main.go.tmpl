// {{.Slug}} is a smallest-possible Reactor workflow generated by
// `reactor new cron-echo {{.Slug}}` on {{.Date}}. It demonstrates:
//
//   - one Step closure with idempotency + timeout
//   - SideEffect for capturing wall-clock time deterministically for replay
//   - the cron-echo trigger shape (any webhook arrives + the workflow runs)
//
// Build:    reactor workflow build --src . --slug {{.Slug}}
// Register: reactor workflow register --db <url> --slug {{.Slug}} --src main.go
// Trigger:  curl -X POST http://127.0.0.1:7777/webhook/<token> \
//             -H 'X-Webhook-Signature: sha256=<hmac>' -d '{"hello":"world"}'
package main

import (
	"context"
	"time"

	"github.com/bright-interaction/reactor/sdk"
	"github.com/bright-interaction/reactor/sdk/runtime"
)

//nolint:gochecknoglobals // SDK contract: package-level declarations.
var (
	Workflow = reactor.Workflow{Slug: "{{.Slug}}", Version: "0.1.0"}
	Trigger  = reactor.WebhookTrigger{
		Path:     "/webhook/{{.Slug}}",
		Provider: "generic",
	}
)

type Payload struct {
	Hello string `json:"hello"`
}

type Echo struct {
	Got     string `json:"got"`
	StepRun int64  `json:"step_run_unix"`
}

func Run(ctx context.Context, flow reactor.Flow, in Payload) error {
	log := flow.Logger()
	log.Info("{{.Slug}}: starting", "hello", in.Hello)

	got := in.Hello
	if got == "" {
		got = "(empty)"
	}

	startUnix, err := reactor.SideEffect(flow, ctx, "captured-time", func() int64 {
		return time.Now().Unix()
	})
	if err != nil {
		return err
	}

	_, err = reactor.Step(flow, ctx, "echo", reactor.StepOpts{
		IdempotencyKey: got,
		Timeout:        5 * time.Second,
	}, func(_ context.Context) (Echo, error) {
		return Echo{Got: got, StepRun: startUnix}, nil
	})
	return err
}

func main() {
	runtime.Serve(Workflow, Trigger, Run)
}
