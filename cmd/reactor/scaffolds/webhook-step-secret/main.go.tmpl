// {{.Slug}} demonstrates a webhook trigger calling an external API
// with a vault-resolved secret. Generated by
// `reactor new webhook-step-secret {{.Slug}}` on {{.Date}}.
package main

import (
	"context"
	"errors"
	"fmt"
	"time"

	"github.com/brightinteraction/reactor/sdk"
	"github.com/brightinteraction/reactor/sdk/runtime"
	"github.com/brightinteraction/reactor/sdk/vault"
)

//nolint:gochecknoglobals // SDK contract: package-level declarations.
var (
	Workflow = reactor.Workflow{Slug: "{{.Slug}}", Version: "0.1.0"}
	Trigger  = reactor.WebhookTrigger{Path: "/webhook/{{.Slug}}", Provider: "generic"}
)

type Payload struct {
	Email string `json:"email"`
}

type Sent struct {
	APIID string `json:"api_id"`
}

func Run(ctx context.Context, flow reactor.Flow, in Payload) error {
	log := flow.Logger()
	if in.Email == "" {
		return reactor.Permanent(errors.New("email required"))
	}
	log.Info("{{.Slug}}: starting", "email", in.Email)

	apiKey, err := vault.MustGet(flow, ctx, "external-api-key")
	if err != nil {
		return err
	}

	out, err := reactor.Step(flow, ctx, "send-email", reactor.StepOpts{
		IdempotencyKey: in.Email,
		Timeout:        15 * time.Second,
	}, func(_ context.Context) (Sent, error) {
		// Replace this with the real API call. The closure runs once
		// per attempt; on replay the cached output is returned without
		// re-execution. Use apiKey.Reveal() at the call site.
		_ = apiKey.Reveal()
		return Sent{APIID: fmt.Sprintf("stub-%s", in.Email)}, nil
	})
	if err != nil {
		return err
	}
	log.Info("{{.Slug}}: sent", "api_id", out.APIID)
	return nil
}

func main() {
	runtime.Serve(Workflow, Trigger, Run)
}
