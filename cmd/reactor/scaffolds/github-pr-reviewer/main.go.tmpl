// {{.Slug}} runs a quick automated review on every opened pull request.
// Generated by `reactor new github-pr-reviewer {{.Slug}}` on {{.Date}}.
//
// Pipeline: GitHub fires a pull_request webhook (action=opened) -> the
// reactor webhook receiver verifies the X-Hub-Signature-256 header ->
// this workflow fetches the diff, asks the configured LLM endpoint for
// a review, posts the result as a PR comment.
//
// Build:    reactor workflow build --src . --slug {{.Slug}}
// Register: reactor workflow register --db <url> --slug {{.Slug}} --src main.go
// Trigger:  dashboard /workflows/{{.Slug}} -> Add webhook trigger -> provider=github.
package main

import (
	"context"
	"encoding/json"
	"fmt"
	"time"

	"github.com/brightinteraction/reactor/sdk"
	httpc "github.com/brightinteraction/reactor/sdk/http"
	"github.com/brightinteraction/reactor/sdk/idempotency"
	"github.com/brightinteraction/reactor/sdk/runtime"
	"github.com/brightinteraction/reactor/sdk/vault"
)

//nolint:gochecknoglobals // SDK contract: package-level declarations.
var (
	Workflow = reactor.Workflow{Slug: "{{.Slug}}", Version: "0.1.0"}
	Trigger  = reactor.WebhookTrigger{
		Path:     "/webhook/{{.Slug}}",
		Provider: "github",
	}
)

type prEvent struct {
	Action      string `json:"action"`
	Number      int    `json:"number"`
	PullRequest struct {
		DiffURL  string `json:"diff_url"`
		Title    string `json:"title"`
		User     struct {
			Login string `json:"login"`
		} `json:"user"`
		Base struct {
			Repo struct {
				FullName string `json:"full_name"` // owner/repo
			} `json:"repo"`
		} `json:"base"`
	} `json:"pull_request"`
}

type Input struct {
	Body json.RawMessage `json:"body"`
}

type Output struct {
	Repo       string `json:"repo"`
	PR         int    `json:"pr"`
	CommentURL string `json:"comment_url"`
	HandledAt  string `json:"handled_at"`
}

func Run(ctx context.Context, flow reactor.Flow, in Input) (Output, error) {
	var ev prEvent
	if err := json.Unmarshal(in.Body, &ev); err != nil {
		return Output{}, reactor.Permanent(fmt.Errorf("parse github event: %w", err))
	}
	if ev.Action != "opened" {
		return Output{}, nil
	}

	repo := ev.PullRequest.Base.Repo.FullName
	prNum := ev.Number
	idemBase := idempotency.Key("{{.Slug}}", "pr", "repo", repo, "pr", fmt.Sprintf("%d", prNum))

	// Step 1: fetch the diff (unauthenticated for public repos; bearer
	// for private).
	diff, err := reactor.Step(flow, ctx, "fetch-diff", reactor.StepOpts{
		IdempotencyKey: idemBase + ":fetch-diff",
		Timeout:        30 * time.Second,
		Retry:          reactor.ExpBackoff{Base: time.Second, Max: 10 * time.Second, Attempts: 3},
	}, func(ctx context.Context) (string, error) {
		c := &httpc.Client{Bearer: string(vault.MustGet("github-pat").Reveal())}
		var body any
		if err := c.Get(ctx, ev.PullRequest.DiffURL, &body); err != nil {
			if !httpc.IsRetryable(err) {
				return "", reactor.Permanent(err)
			}
			return "", err
		}
		raw, _ := json.Marshal(body)
		return string(raw), nil
	})
	if err != nil {
		return Output{}, err
	}

	// Step 2: ask the LLM for a review (your endpoint).
	review, err := reactor.Step(flow, ctx, "llm-review", reactor.StepOpts{
		IdempotencyKey: idemBase + ":llm-review",
		Timeout:        60 * time.Second,
	}, func(ctx context.Context) (string, error) {
		c := &httpc.Client{Bearer: string(vault.MustGet("llm-api-key").Reveal())}
		var resp struct {
			Review string `json:"review"`
		}
		if err := c.PostJSON(ctx, "https://your-llm-endpoint.example/review",
			map[string]any{"title": ev.PullRequest.Title, "author": ev.PullRequest.User.Login, "diff": diff},
			&resp); err != nil {
			if !httpc.IsRetryable(err) {
				return "", reactor.Permanent(err)
			}
			return "", err
		}
		return resp.Review, nil
	})
	if err != nil {
		return Output{}, err
	}

	// Step 3: post the comment back to GitHub.
	commentURL, err := reactor.Step(flow, ctx, "post-comment", reactor.StepOpts{
		IdempotencyKey: idemBase + ":post-comment",
		Timeout:        20 * time.Second,
	}, func(ctx context.Context) (string, error) {
		c := &httpc.Client{Bearer: string(vault.MustGet("github-pat").Reveal())}
		url := fmt.Sprintf("https://api.github.com/repos/%s/issues/%d/comments", repo, prNum)
		var resp struct {
			HTMLURL string `json:"html_url"`
		}
		if err := c.PostJSON(ctx, url, map[string]string{"body": review}, &resp); err != nil {
			if !httpc.IsRetryable(err) {
				return "", reactor.Permanent(err)
			}
			return "", err
		}
		return resp.HTMLURL, nil
	})
	if err != nil {
		return Output{}, err
	}

	return Output{
		Repo: repo, PR: prNum,
		CommentURL: commentURL,
		HandledAt:  time.Now().UTC().Format(time.RFC3339),
	}, nil
}

func main() {
	runtime.Serve[Input](Workflow, Run)
}
