// {{.Slug}} consumes Stripe webhook events. Generated by
// `reactor new stripe-webhook {{.Slug}}` on {{.Date}}.
//
// The webhook receiver verifies the Stripe-Signature header before
// the workflow ever runs (HMAC over the raw body, 5-minute skew
// window, constant-time compare). This file handles the post-verify
// business logic: parse the event, route by type, side-effect.
//
// Build:    reactor workflow build --src . --slug {{.Slug}}
// Register: reactor workflow register --db <url> --slug {{.Slug}} --src main.go
// Trigger:  set up a webhook trigger on /workflows/{{.Slug}} in the
//           dashboard; the URL + secret land in the one-time flash.
package main

import (
	"context"
	"encoding/json"
	"fmt"
	"time"

	"github.com/bright-interaction/reactor/sdk"
	httpc "github.com/bright-interaction/reactor/sdk/http"
	"github.com/bright-interaction/reactor/sdk/idempotency"
	"github.com/bright-interaction/reactor/sdk/runtime"
	"github.com/bright-interaction/reactor/sdk/vault"
)

//nolint:gochecknoglobals // SDK contract: package-level declarations.
var (
	Workflow = reactor.Workflow{Slug: "{{.Slug}}", Version: "0.1.0"}
	Trigger  = reactor.WebhookTrigger{
		Path:     "/webhook/{{.Slug}}",
		Provider: "stripe",
	}
)

type stripeEvent struct {
	ID   string          `json:"id"`
	Type string          `json:"type"`
	Data json.RawMessage `json:"data"`
}

type Input struct {
	Body json.RawMessage `json:"body"`
}

type Output struct {
	EventID    string `json:"event_id"`
	Type       string `json:"type"`
	HandledAt  string `json:"handled_at"`
}

// Run is the workflow body. The SDK's runtime.Serve handles the wire
// protocol; we just declare the step graph here.
func Run(ctx context.Context, flow reactor.Flow, in Input) (Output, error) {
	var ev stripeEvent
	if err := json.Unmarshal(in.Body, &ev); err != nil {
		return Output{}, reactor.Permanent(fmt.Errorf("parse stripe event: %w", err))
	}

	// Side-effecting branch by event type. Each handler is its own
	// Step with an idempotency key derived from the event id so a
	// Stripe retry of the same event is a no-op.
	switch ev.Type {
	case "checkout.session.completed":
		_, err := reactor.Step(flow, ctx, "fulfill-checkout", reactor.StepOpts{
			IdempotencyKey: idempotency.Key("{{.Slug}}", "fulfill-checkout", "event_id", ev.ID),
			Timeout:        20 * time.Second,
			Retry:          reactor.ExpBackoff{Base: time.Second, Max: 10 * time.Second, Attempts: 3},
		}, func(ctx context.Context) (string, error) {
			// Reach the fulfilment API. Bearer comes from the vault so
			// it's encrypted at rest + redacted on accidental log.
			c := &httpc.Client{Bearer: string(vault.MustGet("fulfilment-api-key").Reveal())}
			var resp map[string]any
			if err := c.PostJSON(ctx, "https://fulfilment.example/orders",
				map[string]any{"stripe_event_id": ev.ID, "data": ev.Data}, &resp); err != nil {
				if httpc.IsRetryable(err) {
					return "", err
				}
				return "", reactor.Permanent(err)
			}
			return "fulfilled", nil
		})
		if err != nil {
			return Output{}, err
		}
	case "customer.subscription.deleted":
		_, _ = reactor.Step(flow, ctx, "cancel-account", reactor.StepOpts{
			IdempotencyKey: idempotency.Key("{{.Slug}}", "cancel-account", "event_id", ev.ID),
			Timeout:        10 * time.Second,
		}, func(_ context.Context) (string, error) {
			// TODO: wire your own account-cancel side effect here.
			return "scheduled-cancel", nil
		})
	default:
		// Unknown event type: log + ignore so unhandled events don't
		// block the webhook receiver.
	}

	return Output{
		EventID:   ev.ID,
		Type:      ev.Type,
		HandledAt: time.Now().UTC().Format(time.RFC3339),
	}, nil
}

func main() {
	runtime.Serve[Input](Workflow, Run)
}
