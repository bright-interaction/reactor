// {{.Slug}} demonstrates a human-in-loop approval flow: Step → AwaitSignal
// → Step. The signal token is embedded in the approval email so the
// approver hits a URL that resumes the run. Generated by
// `reactor new approval-flow {{.Slug}}` on {{.Date}}.
package main

import (
	"context"
	"errors"
	"time"

	"github.com/bright-interaction/reactor/sdk"
	"github.com/bright-interaction/reactor/sdk/runtime"
)

//nolint:gochecknoglobals // SDK contract: package-level declarations.
var (
	Workflow = reactor.Workflow{Slug: "{{.Slug}}", Version: "0.1.0"}
	Trigger  = reactor.WebhookTrigger{Path: "/webhook/{{.Slug}}", Provider: "generic"}
)

type Payload struct {
	Subject string `json:"subject"`
}

type EmailSent struct {
	MessageID string `json:"message_id"`
}

type Approval struct {
	Approved bool   `json:"approved"`
	Comment  string `json:"comment,omitempty"`
}

func Run(ctx context.Context, flow reactor.Flow, in Payload) error {
	if in.Subject == "" {
		return reactor.Permanent(errors.New("subject required"))
	}
	log := flow.Logger()

	// Mint the signal token before suspending so the approval email
	// can embed POST /signal/<token> and the receiver knows where to
	// resume the run.
	token := flow.SignalToken("approval")
	log.Info("{{.Slug}}: approval signal token minted", "token", token)

	_, err := reactor.Step(flow, ctx, "send-approval-email", reactor.StepOpts{
		IdempotencyKey: in.Subject,
		Timeout:        15 * time.Second,
	}, func(_ context.Context) (EmailSent, error) {
		// Real implementation: send an email with an Approve button
		// pointing at https://yourdaemon/signal/<token>.
		return EmailSent{MessageID: "stub-" + token}, nil
	})
	if err != nil {
		return err
	}

	// Suspend until the signal arrives or the timeout fires. The
	// supervisor persists state + spins down; resume is automatic.
	signal, err := flow.AwaitSignal(ctx, "approval", 24*time.Hour)
	if err != nil {
		return err
	}
	var ap Approval
	if err := signal.Decode(&ap); err != nil {
		return reactor.Permanent(err)
	}

	if !ap.Approved {
		log.Info("{{.Slug}}: rejected", "comment", ap.Comment)
		return nil
	}

	_, err = reactor.Step(flow, ctx, "execute-approved-action", reactor.StepOpts{
		IdempotencyKey: in.Subject + ":executed",
		Timeout:        30 * time.Second,
	}, func(_ context.Context) (struct{}, error) {
		log.Info("{{.Slug}}: executing approved action", "subject", in.Subject)
		return struct{}{}, nil
	})
	return err
}

func main() {
	runtime.Serve(Workflow, Trigger, Run)
}
